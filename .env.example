# Server port
HTTP_PORT=8002

# Database (PostgreSQL user_db)
DATABASE_URL=postgres://postgres:postgres_secret_pass@localhost:5432/user_db?sslmode=disable

# Redis
REDIS_URL=redis://:redis_secret_pass@localhost:6379/1

# Kafka / Redpanda
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=user-notification-service-group
KAFKA_TOPIC=identity.events

# Mailpit SMTP Server
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@our-sso.local

# Security
JWT_SECRET=super_secret_jwt_hmac_key_min_32_bytes_long_here_12345
