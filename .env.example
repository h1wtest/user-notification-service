# Supply values through generated, non-Git secrets. No credential defaults.
DATABASE_URL=
HTTP_PORT=8002
PUBLIC_ORIGIN=https://localhost:8448
INTERNAL_SERVICE_TOKEN=
NOTIFICATION_INTERNAL_TOKEN=
ADMIN_INTERNAL_TOKEN=
IDENTITY_URL=https://identity-service:8001
PROFILE_URL=https://profile-service:8002
NOTIFICATION_URL=https://notification-service:8003
TLS_CERT_FILE=/run/tls/tls.crt
TLS_KEY_FILE=/run/tls/tls.key
INTERNAL_CA_FILE=/run/tls/ca.crt
# Required only notification/worker; never mount in profile/admin.
DELIVERY_ENCRYPTION_KEY=
# Distinct random key per DB owner.
QUARANTINE_ENCRYPTION_KEY=
KAFKA_BROKERS=redpanda:29092
KAFKA_TLS_CA_FILE=/run/tls/ca.crt
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@sso.local
# Explicit local Mailpit only; absent/false requires STARTTLS.
SMTP_ALLOW_INSECURE=true
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=profile-service
LOG_LEVEL=info
