# Canonical Go owner .env; never commit real values. Empty required keys fail closed.
DATABASE_URL=
HTTP_PORT=8002
PUBLIC_ORIGIN=https://localhost:8448
INTERNAL_SERVICE_TOKEN=
NOTIFICATION_INTERNAL_TOKEN=
ADMIN_INTERNAL_TOKEN=
IDENTITY_URL=https://identity-service:8001
PROFILE_URL=https://profile-service:8002
NOTIFICATION_URL=https://notification-service:8003
BILLING_URL=https://billing-service:8007
SUBSCRIPTION_URL=https://subscription-service:8008
REFERRAL_URL=https://referral-service:8009
# Profile-only JSON integration registry; real random base64 32-byte secrets stay private.
# Each entry: {"secret":"...","event_types":["readiness_changed","trading_alert"],"product_ids":["canonical-uuid"]}
EXTERNAL_EVENT_INTEGRATIONS={}
TLS_CERT_FILE=/run/tls/tls.crt
TLS_KEY_FILE=/run/tls/tls.key
INTERNAL_CA_FILE=/run/tls/ca.crt
# Runtime delivery key is supplied from canonical identity-service/.env by orchestration.
# Do not create a second DELIVERY_ENCRYPTION_KEY here.
# Distinct random key per DB owner.
QUARANTINE_ENCRYPTION_KEY=
KAFKA_BROKERS=redpanda:29092
KAFKA_TLS_CA_FILE=/run/tls/ca.crt
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@sso.local
# Explicit local Mailpit only; absent/false requires STARTTLS.
SMTP_ALLOW_INSECURE=true
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=profile-service
LOG_LEVEL=info
# Canonical per-owner orchestration credentials, not one shared runtime credential.
PROFILE_TOKEN=
NOTIFICATION_TOKEN=
ADMIN_TOKEN=
PROFILE_RUNTIME_PASSWORD=
PROFILE_MIGRATION_PASSWORD=
NOTIFICATION_RUNTIME_PASSWORD=
NOTIFICATION_MIGRATION_PASSWORD=
AUDIT_RUNTIME_PASSWORD=
AUDIT_MIGRATION_PASSWORD=
PROFILE_QUARANTINE_KEY=
NOTIFICATION_QUARANTINE_KEY=
ADMIN_QUARANTINE_KEY=
KAFKA_PROFILE_PASSWORD=
KAFKA_NOTIFICATION_PASSWORD=
KAFKA_ADMIN_PASSWORD=
# TELEGRAM_BOT_TOKEN may be empty: channel unavailable, never simulated success.
# Private service PEM names below use JSON-compatible quoted escaped newlines.
PROFILE_SERVICE_TLS_PRIVATE_KEY=
NOTIFICATION_SERVICE_TLS_PRIVATE_KEY=
NOTIFICATION_WORKER_TLS_PRIVATE_KEY=
ADMIN_AUDIT_SERVICE_TLS_PRIVATE_KEY=
