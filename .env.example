# Server port
HTTP_PORT=8002

# Database (host: localhost:5432, docker: postgres:5432)
DATABASE_URL=postgres://postgres:postgres_secret_pass@postgres:5432/user_db?sslmode=disable

# Redis (host: localhost:6379/1, docker: redis:6379/1)
REDIS_URL=redis://:redis_secret_pass@redis:6379/1

# Kafka / Redpanda (host: localhost:9092, docker: redpanda:29092)
KAFKA_BROKERS=redpanda:29092
KAFKA_CONSUMER_GROUP=user-notification-service-group
KAFKA_TOPIC=identity.events

# Mailpit SMTP Server (host: localhost:1025, docker: mailpit:1025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@our-sso.local

# Security
JWT_SECRET=super_secret_jwt_hmac_key_min_32_bytes_long_here_12345
